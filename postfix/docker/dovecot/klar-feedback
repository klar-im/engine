#!/bin/sh
# Called by Dovecot imapsieve when messages are moved to/from Junk.
# Reads RFC822 message from stdin, extracts X-Klar-Event-ID header,
# and records feedback in the SQLite event store.
# $1 = "spam" or "ham"

VERDICT="$1"
EVENT_STORE="/var/lib/klar/events.sqlite3"

if [ -z "$VERDICT" ]; then
    exit 0
fi

# Read headers from stdin (stop at first blank line)
EVENT_ID=""
while IFS= read -r line; do
    # Strip trailing CR
    line=$(printf '%s' "$line" | tr -d '\r')
    # Empty line = end of headers
    [ -z "$line" ] && break
    # Match X-Klar-Event-ID header (case-insensitive)
    case "$line" in
        [Xx]-[Kk][Ll][Aa][Rr]-[Ee][Vv][Ee][Nn][Tt]-[Ii][Dd]:*)
            EVENT_ID=$(printf '%s' "$line" | sed 's/^[^:]*:[[:space:]]*//')
            ;;
    esac
done

# Drain remaining stdin
cat > /dev/null

# If no event ID, this is not a klar-processed message. The header is carried
# by the message, so anything but a UUID is refused before it reaches SQL.
case "$EVENT_ID" in
    ''|*[!0-9a-fA-F-]*) exit 0 ;;
esac

# The mailbox that moved it: Pigeonhole runs pipe programs with USER set to the
# login. A correction is that mailbox's memory (TASK-547), so the login must be
# the address mail arrives for; anything outside a plain address is dropped.
REPORTER="${USER:-}"
case "$REPORTER" in
    *[!A-Za-z0-9@._+-]*) REPORTER="" ;;
esac

# The table is the milter's (src/event_store.cpp owns the DDL): a message
# with an event id was classified, so the store and the table exist.
TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
sqlite3 "$EVENT_STORE" <<SQL
INSERT INTO feedback (ts, event_id, verdict, source, reporter)
VALUES ('$TS', '$EVENT_ID', '$VERDICT', 'sieve', '$REPORTER');
SQL
