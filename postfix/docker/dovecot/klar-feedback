#!/bin/sh
# Called by Dovecot imapsieve when messages are moved to/from Junk.
# Reads RFC822 message from stdin, extracts X-Klar-Event-ID header,
# and records feedback in the SQLite event store.
# $1 = "spam" or "ham"

VERDICT="$1"
EVENT_STORE="/var/lib/klar/events.sqlite3"

if [ -z "$VERDICT" ]; then
    exit 0
fi

# Read headers from stdin (stop at first blank line)
EVENT_ID=""
while IFS= read -r line; do
    # Strip trailing CR
    line=$(printf '%s' "$line" | tr -d '\r')
    # Empty line = end of headers
    [ -z "$line" ] && break
    # Match X-Klar-Event-ID header (case-insensitive)
    case "$line" in
        [Xx]-[Kk][Ll][Aa][Rr]-[Ee][Vv][Ee][Nn][Tt]-[Ii][Dd]:*)
            EVENT_ID=$(printf '%s' "$line" | sed 's/^[^:]*:[[:space:]]*//')
            ;;
    esac
done

# Drain remaining stdin
cat > /dev/null

# If no event ID, this is not a klar-processed message
if [ -z "$EVENT_ID" ]; then
    exit 0
fi

# Create feedback table if it doesn't exist and insert record
TS=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
sqlite3 "$EVENT_STORE" <<SQL
CREATE TABLE IF NOT EXISTS feedback (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    ts        TEXT NOT NULL,
    event_id  TEXT NOT NULL,
    verdict   TEXT NOT NULL,
    source    TEXT NOT NULL,
    reporter  TEXT NOT NULL
);
INSERT INTO feedback (ts, event_id, verdict, source, reporter)
VALUES ('$TS', '$EVENT_ID', '$VERDICT', 'sieve', '');
SQL
