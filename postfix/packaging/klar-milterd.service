[Unit]
Description=Klar spam-filter milter (Postfix, Stalwart, or any libmilter MTA)
After=network.target

[Service]
Type=simple
User=klarmilter
Group=klarmilter
# postfix/scripts/install.sh puts the binary and every library it loads in one
# directory; LD_LIBRARY_PATH makes that directory the only one that matters.
Environment=LD_LIBRARY_PATH=/opt/klar/bin
ExecStart=/opt/klar/bin/klar-milterd --config /etc/klar/klar-milterd.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
TimeoutStopSec=35
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
# The event store and (if fetched at runtime) the model live here; the model
# may also be read-only elsewhere (model_dir in the toml), which strict allows.
ReadWritePaths=/var/lib/klar

[Install]
WantedBy=multi-user.target
